# Copy to .env for local dev. In Cloud Run, these come from --set-env-vars /
# --set-secrets instead (see deploy/cloudrun.sh) — never commit a filled-in .env.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — only set these if you want a "managed" tier where you front the
# LLM cost. Leave unset to require BYOK (X-Backend-Api-Key header) always.
MANAGED_ANTHROPIC_API_KEY=
MANAGED_OPENAI_API_KEY=

RLM_DEFAULT_BACKEND=anthropic
RLM_DEFAULT_MODEL=claude-sonnet-4-5
RLM_MAX_ITERATIONS_CAP=30
RLM_MAX_DEPTH_CAP=1
RLM_REQUEST_TIMEOUT_S=180
RLM_ENVIRONMENT_KIND=local

PORT=8080
